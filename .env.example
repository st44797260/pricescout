# Supabase 前端连接信息（Project Settings → API）
# 未配置时，前端会自动使用本地模拟后端（localStorage），便于离线演示。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Edge Function 使用的抓取 API（不是 VITE_ 前缀，通过 CLI 配置到服务端）：
#   supabase secrets set FIRECRAWL_API_KEY=fc-xxxx
# 未配置时 scrape-competitor 函数自动进入 mock 模式，返回 20 条模拟产品。

# AI 评分接口（OpenAI 兼容格式，analyze-products 函数使用）：
#   supabase secrets set AI_API_KEY=sk-xxxx
#   supabase secrets set AI_BASE_URL=https://api.openai.com/v1   # 可选
#   supabase secrets set AI_MODEL=gpt-4o-mini                     # 可选
# 未配置时 analyze-products 自动使用内置启发式评分算法（结果结构一致）。

